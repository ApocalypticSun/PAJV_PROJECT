<Window x:Class="Launcher_Proiect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher_Proiect"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1E1E2E" Offset="0"/>
                <GradientStop Color="#E3F4FD" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Width="300"
        Orientation="Vertical">

            <!-- Title -->
            <TextBlock
            Text="LOG IN"
            FontSize="32"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,0,0,30"/>

            <!-- Username Label -->
            <Label
        Content="Enter Player ID"
        FontSize="20"
        HorizontalAlignment="Center"
        Margin="0,0,0,5"
        Foreground="White"/>

            <!-- Username Box -->
            <TextBox
            x:Name="UserNameBox"
            Height="45"
            FontSize="18"
            HorizontalAlignment="Center"
            Margin="0,0,0,20" Width="182"/>

            <!-- Login Button -->
            <Button
            x:Name="LoginButton"
            Content="LOGIN"
            Width="160"
            Height="50"
            FontSize="18"
            Click="Login"
            Margin="0,0,0,15"
            Background="#1E1E2E"
            Foreground="White"
            BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="25">
                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Launch Button -->
            <Button
            x:Name="LaunchButton"
            Content="LAUNCH"
            Width="160"
            Height="50"
            FontSize="18"
            Click="Launch"
            Background="#4CAF50"
            Foreground="White"
            BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="25">
                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Grid>
</Window>
